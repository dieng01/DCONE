# ============================================
# Market Monitor - Environment Configuration
# ============================================

# MQTT Broker URL
# Development (local RESTHeart):
VITE_MQTT_BROKER_URL=ws://localhost:8883/mqtt

# Production (with SSL):
# VITE_MQTT_BROKER_URL=wss://your-domain.com/mqtt

# Public broker for testing (no RESTHeart):
# VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt

# REST API URL
VITE_REST_API_URL=http://localhost:8080

# Production:
# VITE_REST_API_URL=https://your-domain.com/api

# ============================================
# Connection Settings
# ============================================

# Reconnect interval (milliseconds)
VITE_RECONNECT_INTERVAL=5000

# Connection timeout (milliseconds)
VITE_CONNECTION_TIMEOUT=4000

# Max reconnect attempts (0 = unlimited)
VITE_MAX_RECONNECT_ATTEMPTS=0

# ============================================
# Data Settings
# ============================================

# Update interval (milliseconds)
VITE_UPDATE_INTERVAL=2000

# Max history points per chart
VITE_MAX_HISTORY_POINTS=50

# Enable simulation mode (when broker unavailable)
VITE_SIMULATION_MODE=true
